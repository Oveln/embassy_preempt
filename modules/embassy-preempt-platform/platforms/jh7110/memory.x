MEMORY
{
    /* AXI 内存 (512KB) - 0x0800_0000 ~ 0x0807_FFFF */
    RAM : ORIGIN = 0x08000000, LENGTH = 512K
}

/* ============================================================================
 * 平台特定符号定义
 * ============================================================================ */

/* RISC-V hart 配置 */
PROVIDE(_max_hart_id = 0);
PROVIDE(_hart_stack_size = 2K);

/* 堆大小配置 */
PROVIDE(_heap_size = 128K);